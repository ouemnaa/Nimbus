{
  "schema_version": "1.0.0",
  "architecture_id": "dev-web-app-postgres",
  "architecture_version": "1.0.0",
  "status": "approved",
  "title": "Nimbus development web application",
  "cloud": {
    "provider": "aws",
    "region": "us-east-1"
  },
  "resources": [
    {
      "id": "dev-vpc",
      "name": "dev-vpc",
      "provider_type": "aws_vpc",
      "category": "networking",
      "scope": "regional",
      "configuration": {"cidr_block": "10.0.0.0/16"}
    },
    {
      "id": "dev-public-subnet-1",
      "name": "dev-public-subnet-1",
      "provider_type": "aws_subnet",
      "category": "networking",
      "configuration": {"cidr_block": "10.0.1.0/24", "availability_zone": "us-east-1a", "subnet_type": "public", "public": true},
      "depends_on": ["dev-vpc"]
    },
    {
      "id": "dev-private-subnet-1",
      "name": "dev-private-subnet-1",
      "provider_type": "AWS::EC2::Subnet",
      "category": "networking",
      "configuration": {"cidr_block": "10.0.2.0/24", "availability_zone": "us-east-1a", "subnet_type": "private", "private": true},
      "depends_on": ["dev-vpc"]
    },
    {
      "id": "dev-igw",
      "name": "dev-igw",
      "provider_type": "AWS::EC2::InternetGateway",
      "category": "networking",
      "configuration": {}
    },
    {
      "id": "dev-nat-gw",
      "name": "dev-nat-gw",
      "provider_type": "AWS::EC2::NatGateway",
      "category": "networking",
      "configuration": {"allocation_id": "eip-alloc-123", "subnet_id": "dev-public-subnet-1"}
    },
    {
      "id": "dev-alb-sg",
      "name": "dev-alb-sg",
      "provider_type": "AWS::EC2::SecurityGroup",
      "category": "security",
      "configuration": {}
    },
    {
      "id": "dev-ecs-sg",
      "name": "dev-ecs-sg",
      "provider_type": "aws_security_group",
      "category": "security",
      "configuration": {}
    },
    {
      "id": "dev-rds-sg",
      "name": "dev-rds-sg",
      "provider_type": "aws_security_group",
      "category": "security",
      "configuration": {}
    },
    {
      "id": "dev-alb",
      "name": "dev-alb",
      "provider_type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "category": "load_balancing",
      "configuration": {"internal": false}
    },
    {
      "id": "dev-ecs-cluster",
      "name": "dev-ecs-cluster",
      "provider_type": "AWS::ECS::Cluster",
      "category": "compute",
      "configuration": {}
    },
    {
      "id": "dev-ecs-service",
      "name": "dev-ecs-service",
      "provider_type": "AWS::ECS::Service",
      "category": "compute",
      "configuration": {"desired_count": 1, "cpu": 256, "memory": 512, "container_name": "app"}
    },
    {
      "id": "dev-rds-postgres",
      "name": "dev-rds-postgres",
      "provider_type": "AWS::RDS::DBInstance",
      "category": "database",
      "configuration": {"engine": "postgres", "engine_version": "15.5", "instance_class": "db.t3.micro", "allocated_storage": 20, "db_name": "nimbus", "multi_az": false}
    },
    {
      "id": "dev-db-secret",
      "name": "dev-db-secret",
      "provider_type": "AWS::SecretsManager::Secret",
      "category": "security",
      "configuration": {}
    },
    {
      "id": "dev-ecs-execution-role",
      "name": "dev-ecs-execution-role",
      "provider_type": "AWS::IAM::Role",
      "category": "iam",
      "configuration": {"purpose": "ecs_execution"}
    },
    {
      "id": "dev-ecs-logs",
      "name": "dev-ecs-logs",
      "provider_type": "AWS::Logs::LogGroup",
      "category": "observability",
      "configuration": {"retention_in_days": 7}
    }
  ],
  "relationships": [
    {"source": "dev-alb", "target": "dev-ecs-service", "type": "routes_to"},
    {"source": "dev-ecs-service", "target": "dev-rds-postgres", "type": "connects_to"}
  ]
}
