resource "aws_security_group" "{{ alb_sg_label }}" {
  name        = "${local.name_prefix}-alb"
  description = "Allow HTTP traffic to the Application Load Balancer."
  vpc_id      = aws_vpc.{{ vpc_label }}.id

  ingress {
    description = "Development HTTP ingress"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "{{ ecs_sg_label }}" {
  name        = "${local.name_prefix}-ecs"
  description = "Allow ALB traffic to ECS tasks."
  vpc_id      = aws_vpc.{{ vpc_label }}.id

  ingress {
    description     = "Traffic from the ALB"
    from_port       = var.container_port
    to_port         = var.container_port
    protocol        = "tcp"
    security_groups = [aws_security_group.{{ alb_sg_label }}.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "{{ rds_sg_label }}" {
  name        = "${local.name_prefix}-rds"
  description = "Allow PostgreSQL only from ECS tasks."
  vpc_id      = aws_vpc.{{ vpc_label }}.id

  ingress {
    description     = "PostgreSQL from ECS tasks"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.{{ ecs_sg_label }}.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
