resource "aws_vpc" "{{ vpc_label }}" {
  cidr_block           = var.vpc_cidr
  enable_dns_support   = true
  enable_dns_hostnames = true
}

data "aws_availability_zones" "available" {
  state = "available"
}

{% for subnet in public_subnets %}
resource "aws_subnet" "{{ subnet.label }}" {
  vpc_id                  = aws_vpc.{{ vpc_label }}.id
  cidr_block              = "{{ subnet.cidr }}"
  availability_zone       = data.aws_availability_zones.available.names[{{ subnet.az_index }}]
  map_public_ip_on_launch = true
}
{% endfor %}

{% for subnet in private_subnets %}
resource "aws_subnet" "{{ subnet.label }}" {
  vpc_id            = aws_vpc.{{ vpc_label }}.id
  cidr_block        = "{{ subnet.cidr }}"
  availability_zone = data.aws_availability_zones.available.names[{{ subnet.az_index }}]
  map_public_ip_on_launch = false
}
{% endfor %}

resource "aws_internet_gateway" "{{ igw_label }}" {
  vpc_id = aws_vpc.{{ vpc_label }}.id
}

{% if nat_label %}
resource "aws_eip" "{{ eip_label }}" {
  domain = "vpc"
}

resource "aws_nat_gateway" "{{ nat_label }}" {
  allocation_id = aws_eip.{{ eip_label }}.id
  subnet_id     = aws_subnet.{{ public_subnets[0].label }}.id
  depends_on    = [aws_internet_gateway.{{ igw_label }}]
}
{% endif %}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.{{ vpc_label }}.id
}

resource "aws_route" "public_internet" {
  route_table_id         = aws_route_table.public.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.{{ igw_label }}.id
}

{% for subnet in public_subnets %}
resource "aws_route_table_association" "{{ subnet.label }}_public" {
  subnet_id      = aws_subnet.{{ subnet.label }}.id
  route_table_id = aws_route_table.public.id
}
{% endfor %}

{% if private_subnets %}
resource "aws_route_table" "private" {
  vpc_id = aws_vpc.{{ vpc_label }}.id
}

{% if nat_label %}
resource "aws_route" "private_nat" {
  route_table_id         = aws_route_table.private.id
  destination_cidr_block = "0.0.0.0/0"
  nat_gateway_id         = aws_nat_gateway.{{ nat_label }}.id
}
{% endif %}

{% for subnet in private_subnets %}
resource "aws_route_table_association" "{{ subnet.label }}_private" {
  subnet_id      = aws_subnet.{{ subnet.label }}.id
  route_table_id = aws_route_table.private.id
}
{% endfor %}
{% endif %}
