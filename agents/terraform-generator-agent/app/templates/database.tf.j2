resource "aws_db_subnet_group" "{{ db_subnet_group_label }}" {
  name       = "${local.name_prefix}-db-subnet-group"
  subnet_ids = [{% for subnet in private_subnets %}aws_subnet.{{ subnet.label }}.id{% if not loop.last %}, {% endif %}{% endfor %}]
}

resource "aws_db_instance" "{{ db_label }}" {
  identifier             = "${local.name_prefix}-postgres"
  engine                 = "postgres"
  engine_version         = "{{ db_engine_version }}"
  instance_class         = var.db_instance_class
  allocated_storage      = var.db_allocated_storage
  storage_encrypted      = true
  db_name                = var.db_name
  username               = var.db_username
  password               = random_password.{{ db_password_label }}.result
  port                   = 5432
  db_subnet_group_name   = aws_db_subnet_group.{{ db_subnet_group_label }}.name
  vpc_security_group_ids = [aws_security_group.{{ rds_sg_label }}.id]
  publicly_accessible    = false
  multi_az               = var.db_multi_az
  skip_final_snapshot    = var.environment == "dev"
  deletion_protection    = var.environment != "dev"
  apply_immediately      = var.environment == "dev"
}
