TERRAFORM_GENERATOR_HOST=0.0.0.0
TERRAFORM_GENERATOR_PORT=8002

TERRAFORM_BINARY=terraform
GENERATED_ARTIFACTS_DIR=generated

DEFAULT_AWS_REGION=us-east-1
DEFAULT_PROJECT_NAME=nimbus
DEFAULT_ENVIRONMENT=dev

VALIDATION_ENABLE_TERRAFORM_INIT=true
VALIDATION_ENABLE_TERRAFORM_PLAN=false
VALIDATION_TIMEOUT_SECONDS=120

# LLM provider: none | gemini | groq | openrouter | auto
# auto tries Gemini → Groq → OpenRouter and picks first configured.
# Deterministic generation works without any LLM (LLM_PROVIDER=none).
LLM_PROVIDER=none

# Gemini (keep GEMINI_API_KEY for backward compatibility)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=

# Groq
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_FAST=
GROQ_MODEL_STRONG=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_STRONG=

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Feature flags
# Reasoning: detects contradictions and selects deployment strategy.
# Works deterministically even with LLM_PROVIDER=none.
TERRAFORM_REASONING_ENABLED=true

# Reviewer: optional LLM faithfulness check. Skipped when LLM_PROVIDER=none.
TERRAFORM_REVIEWER_ENABLED=true

# LLM draft fallback: MUST remain false in production.
# Only enable for experimental unsupported pattern generation.
# Draft output is always untrusted and requires human review.
TERRAFORM_LLM_DRAFT_FALLBACK_ENABLED=false

GENERATOR_VERSION=0.2.0
